# Copiá este archivo como .env y completá con tus valores reales

# URI de conexion a MongoDB (la misma base de datos que odonto-app)
MONGODB_URI=mongodb://localhost:27017/senza_totem

# Puerto del servidor HTTP/WebSocket (distinto al de odonto-app para no colisionar)
PORT=3001

# URL base del backend del nuevo sistema (turnero)
# En desarrollo local: http://localhost:4000
# En producción: la URL del servidor/servicio web donde esté desplegado el api/
TURNERO_API_URL=http://localhost:4000
