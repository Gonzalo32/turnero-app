{
  "realm": "senza",
  "enabled": true,
  "displayName": "Senza",
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "length(10) and notUsername and passwordHistory(3)",
  "revokeRefreshToken": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 36000,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administra usuarios y sedes" },
      { "name": "odontologo", "description": "Profesional: ve su propia cola" },
      { "name": "secretaria", "description": "Gestiona las colas de los profesionales de su sede" }
    ]
  },
  "clients": [
    {
      "clientId": "turnero-frontend",
      "name": "Turnero (Angular)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "${TURNERO_PUBLIC_URL}",
      "redirectUris": ["${TURNERO_PUBLIC_URL}/*"],
      "webOrigins": ["${TURNERO_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TURNERO_PUBLIC_URL}/*"
      }
    },
    {
      "clientId": "turnero-backend",
      "name": "Turnero backend (Admin API)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "username": "service-account-turnero-backend",
      "enabled": true,
      "serviceAccountClientId": "turnero-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Administrador",
      "lastName": "Senza",
      "email": "admin@senza.local",
      "emailVerified": true,
      "realmRoles": ["admin"],
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_APP_ADMIN_PASSWORD}", "temporary": true }]
    }
  ]
}
