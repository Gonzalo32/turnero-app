# Variables de entorno del backend
# Copiar este archivo como .env y completar con valores reales

# Puerto del servidor HTTP/Socket.IO
PORT=3001

# Orígenes permitidos para CORS (separados por coma si son varios)
CORS_ORIGIN=http://localhost:4300

# URI de MongoDB del NUEVO sistema (base de datos propia, no la del tótem)
MONGODB_URI=mongodb://localhost:27017/senza_sistema

# URI de MongoDB del TÓTEM (solo lectura / integración)
TOTEM_MONGODB_URI=mongodb://localhost:27017/senza_totem

# Clave compartida con el tótem (header x-totem-api-key). Generar con: openssl rand -hex 32
TOTEM_API_KEY=cambiar_esta_clave

# Keycloak. KEYCLOAK_URL es la dirección desde el backend; KEYCLOAK_ISSUER la pública
# (el `iss` de los tokens). En desarrollo coinciden y KEYCLOAK_ISSUER puede omitirse.
KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_ISSUER=https://auth.tu-dominio.com/realms/senza
KEYCLOAK_REALM=senza
KEYCLOAK_ADMIN_CLIENT_ID=turnero-backend
# Debe coincidir con el del docker-compose.yml de la raíz
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-turnero-backend-secret

# Entorno
NODE_ENV=development
