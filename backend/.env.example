# Variables de entorno del backend
# Copiar este archivo como .env y completar con valores reales

# Puerto del servidor HTTP/Socket.IO
PORT=3001

# Orígenes permitidos para CORS (separados por coma si son varios)
CORS_ORIGIN=http://localhost:4300

# URI de MongoDB del NUEVO sistema (base de datos propia, no la del tótem)
MONGODB_URI=mongodb://localhost:27017/senza_sistema

# URI de MongoDB del TÓTEM (solo lectura / integración)
TOTEM_MONGODB_URI=mongodb://localhost:27017/senza_totem

# Secreto compartido con el Tótem para integración
TOTEM_API_KEY=9795f7503a115785900448be243db003d15a3889a2a037b61a9a6ec06fea8b82

# Secreto JWT (para futuro módulo de autenticación)
JWT_SECRET=cambiar_este_secreto_en_produccion

# Entorno
NODE_ENV=development
